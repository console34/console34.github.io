const heroImage = "/images/camino.jpg";
---

<Layout title="Preliminary Programme">
  <div class="min-h-screen bg-stone-950 relative">
    <!-- Hero Section -->
    <div class="relative h-[50vh] w-full overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-stone-950/50 to-stone-950 z-10"></div>
      
      <img
        src={heroImage}
        alt="Preliminary Programme Hero"
        class="w-full h-full object-cover"
      />
      <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
        <Container>
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">Preliminary Programme</h1>
          <p class="text-xl text-gray-300">Slots are still subject to variability</p>
        </Container>
      </div>
    </div>

    <Container>
      <div class="py-12 space-y-16">
        {programData.map((day) => {
          return (
            <div class="space-y-6">
              <div class="border-b border-amber-300/30 pb-4">
                <h2 class="text-3xl md:text-4xl font-bold text-white">{day.date}</h2>
              </div>

              <!-- Desktop Table View -->
              <div class="hidden lg:block overflow-x-auto">
                <table class="w-full border-collapse">
                  <thead>
                    <tr class="border-b border-stone-700">
                      <th class="text-left py-4 px-4 text-amber-300 font-semibold text-sm uppercase tracking-wider">Time</th>
                      <th class="text-left py-4 px-4 text-amber-300 font-semibold text-sm uppercase tracking-wider">Speaker</th>
                      <th class="text-left py-4 px-4 text-amber-300 font-semibold text-sm uppercase tracking-wider">Title</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(day.talks || []).map((session, idx) => (
                    <tr 
                      class={`
                        border-b border-stone-800/50 transition-colors
                        ${session.type === 'keynote' ? 'bg-amber-500/10 hover:bg-amber-500/15' : ''}
                        ${session.type === 'break' ? 'bg-stone-800/30 hover:bg-stone-800/40' : ''}
                        ${session.type === 'presentation' ? 'hover:bg-stone-800/30' : ''}
                      `}
                    >
                      <td class="py-4 px-4 text-stone-300 font-mono text-sm whitespace-nowrap">
                        {session.time}
                      </td>
                      <td class="py-4 px-4 text-white">
                        {session.speaker ? (
                          <span class="font-medium">{session.speaker}</span>
                        ) : (
                          <span class="text-stone-500 italic">—</span>
                        )}
                      </td>
                      <td class="py-4 px-4 text-stone-200">
                        {session.type === 'keynote' ? (
                          <span class="font-bold text-amber-300">{session.title}</span>
                        ) : (
                          <span class={session.type === 'break' ? 'italic text-stone-400' : ''}>
                            {session.title}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Mobile Card View -->
            <div class="lg:hidden space-y-4">
              {(day.talks || []).map((session, idx) => (
                <div 
                  class={`
                    border border-stone-700 rounded-lg p-4 transition-all
                    ${session.type === 'keynote' ? 'bg-amber-500/10 border-amber-500/30' : ''}
                    ${session.type === 'break' ? 'bg-stone-800/30 border-stone-600' : ''}
                    ${session.type === 'presentation' ? 'bg-stone-900/50 hover:bg-stone-800/50' : ''}
                  `}
                >
                  <div class="flex items-start justify-between mb-3">
                    <span class="text-amber-300 font-mono text-sm font-semibold">{session.time}</span>
                    {session.type === 'keynote' && (
                      <span class="bg-amber-500/20 text-amber-300 text-xs px-2 py-1 rounded-full font-semibold">Keynote</span>
                    )}
                    {session.type === 'break' && (
                      <span class="bg-stone-700 text-stone-400 text-xs px-2 py-1 rounded-full italic">Break</span>
                    )}
                  </div>
                  
                  <div class="space-y-2">
                    {session.speaker && (
                      <div>
                        <span class="text-xs text-stone-400 uppercase tracking-wide">Speaker</span>
                        <p class="text-white font-medium mt-1">{session.speaker}</p>
                      </div>
                    )}
                    
                    <div>
                      <span class="text-xs text-stone-400 uppercase tracking-wide">Title</span>
                      <p class={`
                        mt-1
                        ${session.type === 'keynote' ? 'text-amber-300 font-bold' : ''}
                        ${session.type === 'break' ? 'text-stone-400 italic' : 'text-stone-200'}
                      `}>
                        {session.title}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Poster Sessions Section -->
            {day.posters && day.posters.length > 0 && (
              <div class="mt-12 space-y-6">
                <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
                  <div>
                    <p class="text-sm uppercase tracking-[0.25em] text-amber-300">Sala del Comune</p>
                    <h3 class="text-2xl font-bold text-white mt-2">
                      {day.posterSessionName || "Poster Sessions"}
                    </h3>
                  </div>
                </div>

                <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                  {day.posters.map((poster) => (
                    <div class="bg-stone-900/70 border border-white/5 rounded-xl p-4 backdrop-blur-xl shadow-2xl shadow-black/30 transition-all duration-300 hover:-translate-y-1 hover:border-white/15">
                      <p class="text-sm font-semibold text-white">{poster.title}</p>
                      <p class="text-xs text-gray-400 mt-2">{poster.speaker}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
            </div>
          );
        })}
      </div>
    </Container>
    
    <!-- Logos banner -->
    <div class="mt-12 flex justify-center pb-12">
      <Banner />
    </div>
  </div>
</Layout>

<style>
  table {
    min-width: 100%;
  }
  
  /* Smooth scrolling for horizontal table */
  .overflow-x-auto {
    scrollbar-width: thin;
    scrollbar-color: rgba(180, 83, 9, 0.5) transparent;
  }
  
  .overflow-x-auto::-webkit-scrollbar {
    height: 8px;
  }
  
  .overflow-x-auto::-webkit-scrollbar-track {
    background: transparent;
  }
  
  .overflow-x-auto::-webkit-scrollbar-thumb {
    background-color: rgba(180, 83, 9, 0.5);
    border-radius: 4px;
  }
  
  .overflow-x-auto::-webkit-scrollbar-thumb:hover {
    background-color: rgba(180, 83, 9, 0.7);
  }
</style>

